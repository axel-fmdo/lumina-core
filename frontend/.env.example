# =============================================================================
# LUMINA CORE - Frontend Environment Variables
# =============================================================================
# Este archivo contiene las variables de entorno para el frontend React + Vite
# Copia este archivo como .env y reemplaza los valores de ejemplo
# =============================================================================
# IMPORTANTE: En Vite, todas las variables DEBEN tener el prefijo VITE_
# para ser accesibles en el código del cliente
# =============================================================================

# -----------------------------------------------------------------------------
# API Backend Configuration
# -----------------------------------------------------------------------------
# URL base del backend API
# En desarrollo: http://localhost:8000
# En producción: https://api.tu-dominio.com
# 
# Esta variable se usa en el código como: import.meta.env.VITE_API_URL
VITE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# Entorno de ejecución del frontend
# Valores: development, production, staging
# 
# Esta variable se usa en el código como: import.meta.env.VITE_ENVIRONMENT
VITE_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Notas importantes sobre variables de entorno en Vite:
# -----------------------------------------------------------------------------
# 1. Solo las variables con prefijo VITE_ son accesibles en el código cliente
# 2. Las variables se embeben en el bundle durante el build
# 3. NO incluyas información sensible aquí (como API keys secretas)
# 4. Accede a las variables con: import.meta.env.VITE_NOMBRE_VARIABLE
# 5. Variables especiales de Vite disponibles sin configuración:
#    - import.meta.env.MODE (development o production)
#    - import.meta.env.DEV (true en desarrollo)
#    - import.meta.env.PROD (true en producción)
#    - import.meta.env.BASE_URL (URL base de la aplicación)