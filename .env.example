# =============================================================================
# LUMINA CORE - Environment Variables (Root)
# =============================================================================
# Este archivo contiene las variables de entorno para Docker Compose
# Copia este archivo como .env y reemplaza los valores de ejemplo
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Usuario de la base de datos PostgreSQL
POSTGRES_USER=lumina_user

# Contraseña del usuario de PostgreSQL
# IMPORTANTE: Usa una contraseña segura en producción
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Nombre de la base de datos
POSTGRES_DB=lumina_core

# Puerto en el que PostgreSQL estará disponible
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
# Puerto en el que el backend FastAPI estará disponible
BACKEND_PORT=8000

# Clave secreta para JWT tokens
# GENERA UNA NUEVA con: openssl rand -hex 32
# NUNCA uses esta clave de ejemplo en producción
SECRET_KEY=your_secret_key_generate_with_openssl_rand_hex_32

# Algoritmo de encriptación para JWT
ALGORITHM=HS256

# Tiempo de expiración de tokens en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URL del frontend para configurar CORS
FRONTEND_URL=http://localhost:5173

# Entorno de ejecución (development, production, staging)
ENVIRONMENT=development

# Modo debug (True para desarrollo, False para producción)
DEBUG=True

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Puerto en el que el frontend Vite estará disponible
FRONTEND_PORT=5173

# URL del backend API para el frontend
VITE_API_URL=http://localhost:8000

# Entorno del frontend
VITE_ENVIRONMENT=development