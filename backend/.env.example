# =============================================================================
# LUMINA CORE - Backend Environment Variables
# =============================================================================
# Este archivo contiene las variables de entorno para el backend FastAPI
# Copia este archivo como .env y reemplaza los valores de ejemplo
# =============================================================================

# -----------------------------------------------------------------------------
# Database Connection
# -----------------------------------------------------------------------------
# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
# 
# Para Docker: usa 'db' como host (nombre del servicio en docker-compose)
# Para desarrollo local: usa 'localhost' como host
DATABASE_URL=postgresql://lumina_user:your_secure_postgres_password_here@db:5432/lumina_core

# Ejemplo para desarrollo local (fuera de Docker):
# DATABASE_URL=postgresql://lumina_user:your_secure_postgres_password_here@localhost:5432/lumina_core

# -----------------------------------------------------------------------------
# Security & JWT Configuration
# -----------------------------------------------------------------------------
# Clave secreta para firmar tokens JWT
# GENERA UNA NUEVA con: openssl rand -hex 32
# O con Python: python -c "import secrets; print(secrets.token_hex(32))"
# CRÍTICO: NUNCA compartas esta clave ni la subas a Git
SECRET_KEY=your_secret_key_generate_with_openssl_rand_hex_32

# Algoritmo de encriptación para JWT (HS256 es el estándar)
ALGORITHM=HS256

# Tiempo de expiración de los access tokens en minutos
# 30 minutos es recomendado para producción
# Puedes usar valores más altos en desarrollo (ej: 300 = 5 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# URL del frontend para configurar CORS (sin comillas)
# En desarrollo: http://localhost:5173
# En producción: https://tu-dominio.com
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# Entorno de ejecución: development, production, staging
ENVIRONMENT=development

# Modo debug para FastAPI y logs detallados
# True = más logs y mensajes de error detallados (desarrollo)
# False = logs mínimos y errores genéricos (producción)
DEBUG=True